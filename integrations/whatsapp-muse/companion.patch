diff --git a/internal/wa/muse.go b/internal/wa/muse.go
new file mode 100644
index 0000000..de2007a
--- /dev/null
+++ b/internal/wa/muse.go
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MPL-2.0
+package wa
+
+import (
+	"encoding/json"
+	"strings"
+
+	"go.mau.fi/whatsmeow/proto/waAICommonDeprecated"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types/richresponse"
+)
+
+// museRichText extracts visible text only. Never search arbitrary JSON fields:
+// metadata, quoted text and unknown primitives must not satisfy a test nonce.
+func museRichText(msg *waE2E.AIRichResponseMessage) string {
+	var parts []string
+	data := msg.GetUnifiedResponse().GetData()
+	if len(data) > 0 {
+		if len(data) > 1024*1024 {
+			return ""
+		}
+		var response richresponse.RichResponse
+		if json.Unmarshal(data, &response) != nil {
+			return ""
+		}
+		for _, section := range response.Sections {
+			if section.Model == nil {
+				continue
+			}
+			for _, primitive := range section.Model.GetPrimitives() {
+				switch text := primitive.(type) {
+				case *richresponse.GenAIMarkdownTextUXPrimitive:
+					parts = append(parts, text.Text)
+				case *richresponse.FOATextPrimitive:
+					parts = append(parts, text.Text)
+				}
+			}
+		}
+	} else {
+		for _, part := range msg.GetSubmessages() {
+			if part.GetMessageType() == waAICommonDeprecated.AIRichResponseSubMessageType_AI_RICH_RESPONSE_TEXT {
+				parts = append(parts, part.GetMessageText())
+			}
+		}
+	}
+	return strings.Join(parts, "\n")
+}
