+// SPDX-License-Identifier: MPL-2.0
+package wa
+
+import (
+	"go.mau.fi/whatsmeow/proto/waAICommon"
+	"go.mau.fi/whatsmeow/proto/waAICommonDeprecated"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+	"strings"
+	"testing"
+)
+
+func unifiedMuse(data string) *waE2E.AIRichResponseMessage {
+	return &waE2E.AIRichResponseMessage{UnifiedResponse: &waAICommon.AIRichResponseUnifiedResponse{Data: []byte(data)}}
+}
+
+func TestMuseRichText(t *testing.T) {
+	tests := []struct {
+		name string
+		msg  *waE2E.AIRichResponseMessage
+		want string
+	}{
+		{"nil", nil, ""},
+		{"unified", unifiedMuse(`{"sections":[{"view_model":{"__typename":"GenAISingleLayoutViewModel","primitive":{"__typename":"GenAIMarkdownTextUXPrimitive","text":"HARNESS_WHATSAPP_OK_synthetic-0001"}}}],"response_id":"not-visible"}`), "HARNESS_WHATSAPP_OK_synthetic-0001"},
+		{"multilayout", unifiedMuse(`{"sections":[{"view_model":{"__typename":"GenAIVStackLayoutViewModel","primitives":[{"__typename":"GenAIMarkdownTextUXPrimitive","text":"one"},{"__typename":"GenAIMarkdownTextUXPrimitive","text":"two"}]}}]}`), "one\ntwo"},
+		{"metadata", unifiedMuse(`{"response_id":"HARNESS_WHATSAPP_OK_synthetic-0001","sections":[{"view_model":{"__typename":"GenAISingleLayoutViewModel","primitive":{"__typename":"GenAIMetadataTextPrimitive","text":"HARNESS_WHATSAPP_OK_synthetic-0001"}}}]}`), ""},
+		{"unknown", unifiedMuse(`{"sections":[{"view_model":{"__typename":"FutureLayout","text":"HARNESS_WHATSAPP_OK_synthetic-0001"}}]}`), ""},
+		{"malformed", unifiedMuse(`{"sections":`), ""},
+		{"oversized", unifiedMuse(strings.Repeat("x", 1024*1024+1)), ""},
+		{"legacy", &waE2E.AIRichResponseMessage{Submessages: []*waAICommonDeprecated.AIRichResponseSubMessage{{MessageType: waAICommonDeprecated.AIRichResponseSubMessageType_AI_RICH_RESPONSE_TEXT.Enum(), MessageText: proto.String("legacy")}, {MessageText: proto.String("hidden")}}}, "legacy"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := museRichText(tt.msg); got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+	// Exercise the actual archive conversion; outgoing copies are never made incoming.
+	e := &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: types.MuseJID, Sender: types.MuseJID}}, Message: &waE2E.Message{RichResponseMessage: tests[1].msg}}
+	m, ok := toMessage(e, func(j types.JID) types.JID { return j })
+	if !ok || m.Text != tests[1].want || m.FromMe || m.SenderJID != types.MuseJID.String() {
+		t.Fatal("rich reply was not archived with its sender")
+	}
+	e.Message.RichResponseMessage = tests[3].msg
+	if _, ok := toMessage(e, func(j types.JID) types.JID { return j }); ok {
+		t.Fatal("metadata became an archive message")
+	}
+}
