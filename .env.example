OPENAI_API_KEY=
# Optional owner-only Google login for the admin MCP (no paid auth service).
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_OWNER_EMAIL=
OPENAI_MODEL=gpt-5.5
# Application context allowance for OpenAI, independent of laptop memory limits.
OPENAI_CONTEXT=131072
# Required for private API routes. Use a long random value.
OWNER_TOKEN=
# Start services with: .venv/bin/python scripts/dev.py
EXECUTOR=temporal
# New turns use Deep Agents; legacy is available for rollback.
AGENT_RUNTIME=deepagents
TEMPORAL_ADDRESS=localhost:7233
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT=16384

# Optional: runtime data defaults outside the checkout.
# AFTERHOURS_HOME=/absolute/path/to/afterhours
# DATA_DIR=/absolute/path/to/afterhours/state
# BRAIN_DIR=/absolute/path/to/afterhours/brain

# Run .venv/bin/python scripts/setup_gbrain.py before selecting gbrain.
BRAIN_BACKEND=files
# GBRAIN_BINARY=/absolute/path/to/gbrain

# Public web research: ddgs needs no API key; disabled removes both web tools.
WEB_SEARCH_PROVIDER=ddgs
# Optional explicit switch: WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Hosted search can use the existing OPENAI_API_KEY: WEB_SEARCH_PROVIDER=openai
# Optional search-only model override; otherwise uses OPENAI_MODEL.
OPENAI_SEARCH_MODEL=

# Portfolio contact and analytics (all tracking providers off if IDs are blank).
PORTFOLIO_CONTACT_EMAIL=
PORTFOLIO_BOOKING_URL=
PLAUSIBLE_DOMAIN=
LINKEDIN_PARTNER_ID=
X_PIXEL_ID=

# Opaque outreach link registration and private stats (disabled if password is blank).
PORTFOLIO_LINKS_PASSWORD=
# PORTFOLIO_LINKS_DB=/absolute/private/runtime/path/outreach.sqlite

# Optional PostHog UI analytics relay. Use the public project token, never a personal API key.
POSTHOG_PROJECT_TOKEN=
# us or eu; local metrics work without PostHog.
POSTHOG_REGION=us

# Optional owner-only Grok Bot connection proof. Keep real values in the private server environment.
# Copy these from a Grok Bot routine's Webhook section; use HTTPS (port 443).
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
# Generate an independent random bearer token and configure it securely in Grok Bot's custom MCP connection.
GROKBOT_MCP_TOKEN=

# Private read-only Gmail Activity capture. Defaults to the admin Google client.
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
GMAIL_OWNER_EMAIL=
# Google Cloud Pub/Sub topic in the OAuth client's project and authenticated push identity.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
